# ==============================================================================
# iLoveDigital SaaS - Environment Configuration (ilovedigital.online)
# ==============================================================================

APP_NAME="iLoveDigital"
APP_ENV=production
APP_URL=https://ilovedigital.online
APP_TIMEZONE=UTC

# ------------------------------------------------------------------------------
# Database Configuration
# Option 1: SQLite (Default, Zero-Setup, Works out of the box on Hostinger)
# ------------------------------------------------------------------------------
DB_CONNECTION=sqlite
DB_DATABASE=data/database.sqlite

# ------------------------------------------------------------------------------
# Option 2: Hostinger MySQL / MariaDB (Recommended for High Traffic)
# In Hostinger hPanel -> Databases -> MySQL Databases -> Create Database
# ------------------------------------------------------------------------------
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=u123456789_creatorpulse
# DB_USERNAME=u123456789_creatoruser
# DB_PASSWORD=your_secure_mysql_password

# ------------------------------------------------------------------------------
# Google Tag Manager & Google Analytics 4 (khalilksa33@gmail.com)
# ------------------------------------------------------------------------------
# In Google Tag Manager (tagmanager.google.com), create a Web container for ilovedigital.online:
# GTM_ID=GTM-XXXXXXX
#
# Or in Google Analytics 4 (analytics.google.com), create a Web Data Stream for https://ilovedigital.online:
# GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# Google OAuth 2.0 (Register & Sign in with Google / Gmail)
# ------------------------------------------------------------------------------
# 1. Visit Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID for "Web Application"
# 3. Add Authorized JavaScript origin: https://ilovedigital.online
# 4. Add Authorized redirect URI: https://ilovedigital.online/auth/google/callback
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Optional AI Integration (OpenAI or Google Gemini)
# ------------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
